{
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "framework": "docusaurus",
  "redirects": [
    {
      "source": "/",
      "destination": "https://www.zen-mesh.io/docs/",
      "statusCode": 308
    },
    {
      "source": "/docs",
      "destination": "https://www.zen-mesh.io/docs/",
      "statusCode": 308
    },
    {
      "source": "/docs/",
      "destination": "https://www.zen-mesh.io/docs/",
      "statusCode": 308
    },
    {
      "source": "/docs/:path*",
      "destination": "https://www.zen-mesh.io/docs/zen-mesh/:path*",
      "statusCode": 308
    },
    {
      "source": "/zen-lock",
      "destination": "https://www.zen-mesh.io/docs/zen-lock/",
      "statusCode": 308
    },
    {
      "source": "/zen-lock/",
      "destination": "https://www.zen-mesh.io/docs/zen-lock/",
      "statusCode": 308
    },
    {
      "source": "/zen-lock/:path*",
      "destination": "https://www.zen-mesh.io/docs/zen-lock/:path*",
      "statusCode": 308
    },
    {
      "source": "/helm-charts",
      "destination": "https://www.zen-mesh.io/docs/helm-charts/",
      "statusCode": 308
    },
    {
      "source": "/helm-charts/",
      "destination": "https://www.zen-mesh.io/docs/helm-charts/",
      "statusCode": 308
    },
    {
      "source": "/helm-charts/:path*",
      "destination": "https://www.zen-mesh.io/docs/helm-charts/:path*",
      "statusCode": 308
    },
    {
      "source": "/zen-gc",
      "destination": "https://www.zen-mesh.io/docs/zen-gc/",
      "statusCode": 308
    },
    {
      "source": "/zen-gc/",
      "destination": "https://www.zen-mesh.io/docs/zen-gc/",
      "statusCode": 308
    },
    {
      "source": "/zen-gc/:path*",
      "destination": "https://www.zen-mesh.io/docs/zen-gc/:path*",
      "statusCode": 308
    }
  ],
  "headers": [
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/ai/(.*\\.json)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, must-revalidate"
        }
      ]
    }
  ]
}